# Copy to .env (git-ignored) and fill in. Read by docker-compose.yml.

# --- Database (the compose Postgres is created with these) ---
POSTGRES_DB=spring_ai_test
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- AI provider (any OpenAI-compatible API) ---
AI_API_KEY=
# Optional below: uncomment to override. Commented-out lines use the defaults
# shown; don't leave an uncommented line empty unless noted.

# Include the /v1 suffix. OpenAI: https://api.openai.com/v1
# Groq: https://api.groq.com/openai/v1 | DeepSeek: https://api.deepseek.com/v1
# Ollama (host machine): http://host.docker.internal:11434/v1
#AI_BASE_URL=https://openrouter.ai/api/v1

# Vision model that reads statement pages - must accept image input.
#AI_CHAT_MODEL=minimax/minimax-m3.1-flash:free

# Categorization model - defaults to AI_CHAT_MODEL.
#AI_CATEGORIZATION_MODEL=

#AI_TIMEOUT=600s

# low | medium | high. Set it EMPTY (AI_REASONING_EFFORT=) for models that
# reject the reasoning_effort parameter.
#AI_REASONING_EFFORT=low

# Client-side cap; keep just under your provider/plan limit.
#AI_RATE_LIMIT_PER_MINUTE=18

# --- Server only: S3 bucket for deploy/backup-db.sh ---
#BACKUP_BUCKET=

# --- Logging (optional) ---
# DEBUG shows the category chosen for every transaction. It logs real bank data:
# use it locally only, never on the server.
#APP_LOG_LEVEL=DEBUG
# Print every SQL statement (very noisy).
#SHOW_SQL=true
